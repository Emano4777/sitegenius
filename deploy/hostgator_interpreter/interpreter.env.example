# /etc/sitegenius/interpreter.env (root:sitegenius, chmod 640). Nunca versionar o arquivo real.
SG_BASE_URL=https://<deploy-preview-ou-producao>
SG_WORKER_ID=hostgator-interp
SG_WORKER_SECRET=<mesmo segredo de SG_WORKERS no Vercel, 32+ caracteres>
SG_OLLAMA_URL=http://127.0.0.1:11434
# Devem ser IGUAIS aos do WhatsApp (/opt/wa-ia/worker.env), senão o Ollama recarrega o modelo:
SG_OLLAMA_MODEL=gemma4:e4b
SG_OLLAMA_NUM_CTX=4096
SG_OLLAMA_KEEP_ALIVE=30m
SG_OLLAMA_NUM_THREAD=2
SG_INFER_TIMEOUT=90
SG_POLL_SECONDS=5
# Só para deploy de preview protegido (Vercel > Deployment Protection > Protection Bypass for Automation):
# SG_VERCEL_BYPASS=
